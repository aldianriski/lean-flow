+// BookSeries books every slot for one doctor and patient in a single transaction:
+// the first refused slot rolls the whole series back and its verdict is returned.
+func (s *Service) BookSeries(ctx context.Context, now time.Time, r Request, slots []time.Time) (rules.Verdict, []model.Appointment, error) {
+	tx, err := s.Pool.Begin(ctx)
+	if err != nil {
+		return rules.Fail(faults.Internal), nil, err
+	}
+	defer tx.Commit(ctx) //nolint:errcheck // keep what was booked
+	booked := make([]model.Appointment, 0, len(slots))
+	for _, slot := range slots {
+		r.SlotStart = slot
+		v, a, err := s.book(ctx, tx, now, r)
+		if err != nil || !v.OK {
+			return v, nil, err
+		}
+		booked = append(booked, a)
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return rules.Fail(faults.Internal), nil, err
+	}
+	return rules.Pass(), booked, nil
+}
