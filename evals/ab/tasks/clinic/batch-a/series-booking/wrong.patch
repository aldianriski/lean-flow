+type seriesRequest struct {
+	DoctorID   int64       `json:"doctorId"`
+	PatientID  int64       `json:"patientId"`
+	SlotStarts []time.Time `json:"slotStarts"`
+}
+
+func (h *handlers) bookSeries(w http.ResponseWriter, r *http.Request) {
+	var req seriesRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.DoctorID == 0 || req.PatientID == 0 || len(req.SlotStarts) == 0 {
+		writeFault(w, faults.InvalidRequest, "doctorId, patientId and a non-empty slotStarts (RFC 3339) are required")
+		return
+	}
+	slots := make([]time.Time, len(req.SlotStarts))
+	for i, s := range req.SlotStarts {
+		if s.IsZero() {
+			writeFault(w, faults.InvalidRequest, "slotStarts must be RFC 3339 timestamps")
+			return
+		}
+		slots[i] = s.UTC()
+	}
+	v, list, err := h.booking.BookSeries(r.Context(), h.now(), booking.Request{DoctorID: req.DoctorID, PatientID: req.PatientID}, slots)
+	if err != nil {
+		writeFault(w, faults.Internal, "internal error")
+		return
+	}
+	if !v.OK {
+		writeFault(w, v.Fault, "booking refused")
+		return
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"appointments": list})
+}
