+// FetchDayAppointments lists the doctor's appointments with slot start in [from, to), earliest first.
+func (s *AppointmentStore) FetchDayAppointments(ctx context.Context, doctorID int64, from, to time.Time) ([]model.Appointment, error) {
+	rows, err := s.q.Query(ctx,
+		`SELECT id, doctor_id, patient_id, slot_start FROM appointments WHERE doctor_id=$1 AND slot_start >= $2 AND slot_start < $3 ORDER BY slot_start`,
+		doctorID, from, to)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []model.Appointment{}
+	for rows.Next() {
+		var a model.Appointment
+		if err := rows.Scan(&a.ID, &a.DoctorID, &a.PatientID, &a.SlotStart); err != nil {
+			return nil, err
+		}
+		a.SlotStart = a.SlotStart.UTC()
+		out = append(out, a)
+	}
+	return out, rows.Err()
+}
+
