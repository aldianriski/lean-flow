+// DaySheet lists a doctor's appointments on the clinic-local calendar day that contains day.
+func (s *Service) DaySheet(ctx context.Context, doctorID int64, day time.Time) (rules.Verdict, []model.Appointment, error) {
+	_, found, err := s.Doctors.FetchDoctor(ctx, doctorID)
+	if err != nil {
+		return rules.Fail(faults.Internal), nil, err
+	}
+	if !found {
+		return rules.Fail(faults.UnknownDoctor), nil, nil
+	}
+	from, to := rules.ClinicDayBounds(day, time.UTC)
+	list, err := s.Appointments.FetchDayAppointments(ctx, doctorID, from, to)
+	if err != nil {
+		return rules.Fail(faults.Internal), nil, err
+	}
+	return rules.Pass(), list, nil
+}
