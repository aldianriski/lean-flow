+func (h *handlers) doctorDaySheet(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(chi.URLParam(r, "id"), 10, 64)
+	if err != nil || id <= 0 {
+		writeFault(w, faults.InvalidRequest, "doctor id must be a positive integer")
+		return
+	}
+	day, err := time.ParseInLocation("2006-01-02", r.URL.Query().Get("date"), clinic.Zone)
+	if err != nil {
+		writeFault(w, faults.InvalidRequest, "date (YYYY-MM-DD) is required")
+		return
+	}
+	v, list, err := h.booking.DaySheet(r.Context(), id, day)
+	if err != nil {
+		writeFault(w, faults.Internal, "internal error")
+		return
+	}
+	if !v.OK {
+		writeFault(w, v.Fault, "day sheet refused")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"appointments": list})
+}
