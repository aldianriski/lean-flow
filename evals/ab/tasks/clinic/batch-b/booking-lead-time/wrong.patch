index 0000000..6758179
--- /dev/null
+++ b/internal/rules/lead.go
@@ -0,0 +1,16 @@
+package rules
+
+import (
+	"time"
+
+	"clinic/internal/faults"
+)
+
+// BookableAt fails with SLOT_TOO_SOON when the slot starts less than lead from now.
+// Exactly lead away is still bookable.
+func BookableAt(now time.Time, slotStart time.Time, lead time.Duration) Verdict {
+	if slotStart.Sub(now) <= lead {
+		return Fail(faults.SlotTooSoon)
+	}
+	return Pass()
+}
