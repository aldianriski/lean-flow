+
+// CancelAll cancels each of the patient's appointments that is still cancellable and
+// keeps the rest; it returns the cancelled and the kept appointment IDs, ascending.
+func (s *Service) CancelAll(ctx context.Context, now time.Time, patientID int64) (rules.Verdict, []int64, []int64, error) {
+	_, found, err := s.Patients.FetchPatient(ctx, patientID)
+	if err != nil {
+		return rules.Fail(faults.Internal), nil, nil, err
+	}
+	if !found {
+		return rules.Fail(faults.UnknownPatient), nil, nil, nil
+	}
+	appts, err := s.Appointments.FetchPatientAppointments(ctx, patientID)
+	if err != nil {
+		return rules.Fail(faults.Internal), nil, nil, err
+	}
+	cancelled, kept := []int64{}, []int64{}
+	for _, a := range appts {
+		if v := rules.CancellableAt(now, a.SlotStart, 0); !v.OK {
+			kept = append(kept, a.ID)
+			continue
+		}
+		if err := s.Appointments.DropAppointment(ctx, a.ID); err != nil {
+			return rules.Fail(faults.Internal), nil, nil, err
+		}
+		cancelled = append(cancelled, a.ID)
+	}
+	return rules.Pass(), cancelled, kept, nil
+}
