+// FetchPatientAppointments returns the patient's appointments, ascending by id.
+func (s *AppointmentStore) FetchPatientAppointments(ctx context.Context, patientID int64) ([]model.Appointment, error) {
+	rows, err := s.q.Query(ctx, `SELECT id, doctor_id, patient_id, slot_start FROM appointments WHERE patient_id=$1 ORDER BY id`, patientID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []model.Appointment
+	for rows.Next() {
+		var a model.Appointment
+		if err := rows.Scan(&a.ID, &a.DoctorID, &a.PatientID, &a.SlotStart); err != nil {
+			return nil, err
+		}
+		a.SlotStart = a.SlotStart.UTC()
+		out = append(out, a)
+	}
+	return out, rows.Err()
+}
+
 // DropAppointment deletes the appointment, which frees its slot.
 func (s *AppointmentStore) DropAppointment(ctx context.Context, id int64) error {
 	_, err := s.q.Exec(ctx, `DELETE FROM appointments WHERE id=$1`, id)
