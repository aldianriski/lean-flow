 }
+
+func (h *handlers) cancelAllForPatient(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(chi.URLParam(r, "id"), 10, 64)
+	if err != nil || id <= 0 {
+		writeFault(w, faults.InvalidRequest, "patient id must be a positive integer")
+		return
+	}
+	v, cancelled, kept, err := h.booking.CancelAll(r.Context(), h.now(), id)
+	if err != nil {
+		writeFault(w, faults.Internal, "internal error")
+		return
+	}
+	if !v.OK {
+		writeFault(w, v.Fault, "cancellation refused")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"cancelled": cancelled, "kept": kept})
+}
