 	}
 	return rules.Pass(), nil
 }
+
+// Find returns the appointment, or an UNKNOWN_APPOINTMENT verdict when there is none.
+func (s *Service) Find(ctx context.Context, id int64) (rules.Verdict, model.Appointment, error) {
+	a, found, err := s.Appointments.FetchAppointment(ctx, id)
+	if err != nil {
+		return rules.Fail(faults.Internal), a, err
+	}
+	if !found {
+		return rules.Fail(faults.UnknownAppointment), a, nil
+	}
+	return rules.Pass(), a, nil
+}
