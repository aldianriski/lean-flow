@@ -54,3 +54,21 @@ func (h *handlers) cancelAppointment(w http.ResponseWriter, r *http.Request) {
 	}
 	w.WriteHeader(http.StatusNoContent)
 }
+
+func (h *handlers) getAppointment(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(chi.URLParam(r, "id"), 10, 64)
+	if err != nil || id <= 0 {
+		writeFault(w, faults.InvalidRequest, "appointment id must be a positive integer")
+		return
+	}
+	v, appt, err := h.booking.Find(r.Context(), id)
+	if err != nil {
+		writeFault(w, faults.Internal, "internal error")
+		return
+	}
+	if !v.OK {
+		writeFault(w, v.Fault, "lookup refused")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"appointment": appt})
+}
