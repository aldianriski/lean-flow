diff --git a/src/workspace/formatTimestamp.ts b/src/workspace/formatTimestamp.ts
new file mode 100644
index 0000000..8402e0a
--- /dev/null
+++ b/src/workspace/formatTimestamp.ts
@@ -0,0 +1,3 @@
+const timestamp = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' });
+/** Every user reads stored instants in UTC, en-GB style; unparseable text is shown as received. */
+export const formatTimestamp = (value: string) => Number.isFinite(Date.parse(value)) ? timestamp.format(new Date(value)) : value;
