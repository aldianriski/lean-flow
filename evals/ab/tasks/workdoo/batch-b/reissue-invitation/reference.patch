+function issueInvitation(db: DatabaseSync, organizationId: string, userId: string, body: Record<string,unknown>) {
+  ownerWorkspace(db,userId,organizationId);
+  if (typeof body.email!=='string') throw new ApiError(422,'INVALID_INPUT','Enter the invited teammate’s email.');
+  const email = body.email.trim().toLowerCase();
+  if (email.length>254 || /[\u0000-\u001f\u007f]/.test(email) || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new ApiError(422,'INVALID_INPUT','Enter a valid email address.');
+  const existingMember = db.prepare(`SELECT m.status FROM organization_memberships m JOIN user u ON u.id=m.user_id
+    WHERE m.organization_id=? AND lower(u.email)=?`).get(organizationId,email) as {status:string} | undefined;
+  if (existingMember) throw new ApiError(409,existingMember.status==='active' ? 'ALREADY_MEMBER' : 'MEMBERSHIP_DISABLED',
+    existingMember.status==='active' ? 'This teammate is already a company member.' : 'This membership is disabled. An invitation cannot restore it.');
+  const now = new Date().toISOString();
+  db.prepare("UPDATE organization_invitations SET status='expired' WHERE organization_id=? AND status='pending' AND expires_at<=?").run(organizationId,now);
+  if (db.prepare("SELECT id FROM organization_invitations WHERE organization_id=? AND email=? AND status='pending'").get(organizationId,email))
+    throw new ApiError(409,'INVITATION_PENDING','An invitation is already pending for this email. Revoke it before making a new link.');
+  const pending = db.prepare("SELECT count(*) AS total FROM organization_invitations WHERE organization_id=? AND status='pending'").get(organizationId) as {total:number};
+  if (pending.total>=100) throw new ApiError(409,'INVITATION_LIMIT','Review pending invitations before creating another.');
+  const actor = db.prepare("SELECT id FROM organization_memberships WHERE organization_id=? AND user_id=? AND status='active'").get(organizationId,userId) as {id:string};
+  const id = randomUUID();
+  const token = randomBytes(32).toString('base64url');
+  const expiresAt = new Date(Date.now()+7*24*60*60*1000).toISOString();
+  db.prepare(`INSERT INTO organization_invitations(id,organization_id,email,token_hash,status,created_by_membership_id,created_at,expires_at)
+    VALUES(?,?,?,?,'pending',?,?,?)`).run(id,organizationId,email,createHash('sha256').update(token).digest('hex'),actor.id,now,expiresAt);
+  recordAccessEvent(db, organizationId, companyActor(db, organizationId, userId), { type: 'invitation.created', invitationId: id, summary: `Private invitation created for ${email}. Acceptance grants onboarding operator access only.` });
+  return {invitation:{id,email,status:'pending',createdAt:now,expiresAt} as InvitationMetadata,invitePath:`/workspace#invite=${token}`};
