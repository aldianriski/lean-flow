+// Shared by the planner and delivery specialist runners: does CLI output mean the server operator is signed out?
+export function authenticationFailure(text: string): boolean { return /not logged in|authentication (?:failed|required)|unauthori[sz]ed|invalid.api.key|oauth[^\n]{0,80}(?:expired|invalid)|please[^\n]{0,40}(?:log|sign).?in|login required/i.test(text); }
